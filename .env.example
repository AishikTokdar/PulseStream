# PulseStream Environment Variables Example

# App Settings
PROJECT_NAME="PulseStream"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="super-secret-key-change-this-in-production-pulsestream-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulsestream_db
POSTGRES_USER=pulsestream_user
POSTGRES_PASSWORD=pulsestream_password
DATABASE_URL=postgresql+asyncpg://pulsestream_user:pulsestream_password@postgres:5432/pulsestream_db

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# RabbitMQ & Celery
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=pulsestream-exports
MINIO_SECURE=false

# Observability (OTEL / Prometheus)
OTEL_SERVICE_NAME=pulsestream-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
PROMETHEUS_METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
